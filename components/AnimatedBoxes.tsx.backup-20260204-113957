"use client"

import { useState, useEffect, useRef, useMemo, useCallback } from "react"
import { motion, AnimatePresence } from "framer-motion"
import PhysicsSpill from './PhysicsSpill'

interface Chip {
  id: string
  label: string
  boxIndex: number
  rotation: number
  xOffset: number
  finalY: number
}

interface AnimatedBoxesProps {
  scrollProgress: number
  isFooterVisible: boolean
  areBoxesVisible: boolean
  shouldResetSpill: boolean
  onResetComplete: () => void
}

export default function AnimatedBoxes({ scrollProgress, isFooterVisible, areBoxesVisible, shouldResetSpill, onResetComplete }: AnimatedBoxesProps) {
  const [bouncingBox, setBouncingBox] = useState<number | null>(null)
  const hasSpilledRef = useRef(false)
  const [showBoxes, setShowBoxes] = useState(true)

  const boxes = [
    { label: "PRODUCTS", rotation: -4 },
    { label: "PLACES", rotation: 3 },
    { label: "SYSTEMS", rotation: -5 },
  ]

  const chipsByBox = {
    PRODUCTS: [
      "UX/UI design",
      "Product design",
      "User research",
      "Prototyping",
      "Data visualization",
      "Automation design",
    ],
    PLACES: [
      "Wayfinding",
      "Environmental graphics",
      "Exhibitions",
      "Print",
      "Place-based activation",
    ],
    SYSTEMS: [
      "Brand strategy",
      "Visual systems",
      "Design systems",
      "Facilitation",
      "Community engagement",
      "Civic tech",
    ],
  }

  const allChips = useMemo(() => {
    const chips: Chip[] = []
    boxes.forEach((box, boxIndex) => {
      const boxChips = chipsByBox[box.label as keyof typeof chipsByBox]
      boxChips.forEach((label, chipIndex) => {
        chips.push({
          id: `${boxIndex}-${chipIndex}`,
          label,
          boxIndex,
          rotation: Math.random() < 0.3
            ? -(Math.random() * 90 + 15)
            : Math.random() * 105 - 15,
          xOffset: Math.random() * 40 - 20,
          finalY: -50 + (chipIndex * 16),
        })
      })
    })
    return chips
  }, []) // empty deps — runs once only

  const handleBoxClick = (boxIndex: number) => {
    setBouncingBox(boxIndex)
    setTimeout(() => setBouncingBox(null), 1200)
  }

  useEffect(() => {
    if (isFooterVisible && !hasSpilledRef.current) {
      hasSpilledRef.current = true
      setShowBoxes(false)
    }
  }, [isFooterVisible])

  useEffect(() => {
    if (shouldResetSpill) {
      // Reset the spill state
      hasSpilledRef.current = false
      setShowBoxes(true)
      onResetComplete()
    }
  }, [shouldResetSpill, onResetComplete])

  return (
    <div className="relative px-0 py-0">
      <div className="min-h-[230px] relative">
        <motion.div
          className="flex items-end gap-8 relative"
          initial={{ opacity: 1, y: 0 }}
          animate={{
            opacity: showBoxes ? 1 : 0,
            y: showBoxes ? 0 : 100
          }}
          transition={{
            opacity: { duration: 0.4 },
            y: { duration: 0.6, ease: "easeOut" }
          }}
        >
          {boxes.map((box, boxIndex) => (
            <div
              key={box.label}
              className="relative cursor-pointer"
              onClick={() => handleBoxClick(boxIndex)}
            >
              <div className="relative w-[200px]">
                <img
                  src="/images/open-box.svg"
                  alt={`${box.label} box`}
                  className="w-full h-auto relative z-10"
                />
                <div
                  className="absolute top-[55%] left-1/2 z-20 text-xs font-bold tracking-wider text-black px-2 py-1 bg-white/90 border border-black"
                  style={{
                    transform: `translateX(-50%) rotate(${box.rotation}deg)`,
                  }}
                >
                  {box.label}
                </div>
              </div>

              <div className="absolute top-0 left-0 w-full h-[160px]">
                {allChips
                  .filter((chip) => chip.boxIndex === boxIndex)
                  .map((chip, i) => {
                    const chipGlobalIndex = allChips.indexOf(chip)
                    const threshold = (chipGlobalIndex + 1) / (allChips.length + 1)
                    const isLanded = scrollProgress >= threshold && showBoxes

                    return (
                      <motion.div
                        key={chip.id}
                        animate={{
                          y: bouncingBox === boxIndex
                            ? isLanded
                              ? [chip.finalY, chip.finalY - 100, chip.finalY - 100, chip.finalY - 80, chip.finalY]
                              : -1000
                            : isLanded ? chip.finalY : -1000,
                          x: bouncingBox === boxIndex && isLanded
                            ? [0, chip.xOffset * 2.5, chip.xOffset * 2.5, chip.xOffset * 1.5, 0]
                            : 0,
                          opacity: isLanded ? 1 : 0,
                          rotate: chip.rotation,
                        }}
                        transition={{
                          y: bouncingBox === boxIndex
                            ? { duration: 1.2, times: [0, 0.3, 0.5, 0.7, 1], ease: "easeOut" }
                            : { duration: 0.4, ease: "easeOut" },
                          x: bouncingBox === boxIndex
                            ? { duration: 1.2, times: [0, 0.3, 0.5, 0.7, 1] }
                            : { duration: 0.4 },
                          opacity: { duration: 0.3 },
                          rotate: { duration: 0.4 },
                        }}
                        className="absolute px-3 py-1 rounded-full text-xs whitespace-nowrap"
                        style={{
                          left: `calc(50% + ${chip.xOffset}px - 50px)`,
                          border: "1.5px solid #ff00a0",
                          color: "#ff00a0",
                          backgroundColor: "white",
                          zIndex: 5,
                          visibility: isLanded ? 'visible' : 'hidden',
                        }}
                        suppressHydrationWarning
                      >
                        {chip.label}
                      </motion.div>
                    )
                  })}
              </div>
            </div>
          ))}
        </motion.div>
      </div>

      {/* Physics-based spill */}
      <PhysicsSpill
        isActive={isFooterVisible}
        shouldReset={shouldResetSpill}
        boxes={boxes}
        chips={allChips}
      />
    </div>
  )
}